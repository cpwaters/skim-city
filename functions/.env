# Non-secret Cloud Functions config. Safe to commit — secrets go in
# `firebase functions:secrets:set` (production) or .secret.local (emulator).

SITE_URL=https://skimcity.co.uk

# `sandbox` while testing, `production` when live.
SQUARE_ENVIRONMENT=sandbox

# Must match the notification URL registered in the Square developer dashboard
# exactly — Square signs over this string, so a mismatch fails verification.
SQUARE_WEBHOOK_URL=https://europe-west2-skimcity-bac3b.cloudfunctions.net/squareWebhook

FROM_EMAIL=Skim City <chris@skimcity.co.uk>

# Flip to true once a reCAPTCHA v3 site key is configured for App Check.
ENFORCE_APP_CHECK=false
