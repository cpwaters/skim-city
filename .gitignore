# Dependencies and build output
node_modules/
dist/
functions/lib/

# ---------------------------------------------------------------------------
# Environment files
#
# Firebase's convention: `.env` holds non-secret runtime parameters and IS
# committed, so a deploy from CI gets the same config as a deploy from a laptop.
# Anything with real credentials lives in `.env.local` / `.secret.local`, or in
# `firebase functions:secrets:set`, and never touches the repo.
# ---------------------------------------------------------------------------
.env
.env.*
*.local
!functions/.env

# Firebase CLI
.firebase/
firebase-debug.log
firestore-debug.log
database-debug.log
pubsub-debug.log
ui-debug.log
*-debug.log

# Generated from /shared/domain.ts by `npm run sync:types`
web/src/types/domain.ts
functions/src/domain.ts

# OS
.DS_Store
Thumbs.db

